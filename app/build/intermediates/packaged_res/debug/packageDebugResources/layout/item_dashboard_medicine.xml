<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/card_bg"
    android:padding="16dp"
    android:layout_marginBottom="8dp"
    android:gravity="center_vertical">

    <!-- Med Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvMedName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aspirin"
            android:textColor="@color/textColorPrimary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="@font/cairo_medium"/>

        <TextView
            android:id="@+id/tvMedTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="08:00 AM"
            android:textColor="@color/colorPrimary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvMedDose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5 mg"
            android:textColor="@color/textColorSecondary"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Action Buttons -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp">

        <Button
            android:id="@+id/btnLogDose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/btn_primary"
            android:text="@string/log_dose"
            android:textStyle="bold"
            android:fontFamily="@font/cairo_medium"
            android:textSize="12sp"
            android:textColor="@color/white"
            android:minHeight="36dp"
            android:textAppearance="@style/CairoMediumStyle"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />

        <TextView
            android:id="@+id/tvTakenIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/taken"
            android:background="@drawable/btn_success"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:visibility="gone"/>

    </FrameLayout>
</LinearLayout>
